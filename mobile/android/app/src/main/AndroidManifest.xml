<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Driver perlu tetap terlacak saat layarnya terkunci: ojek tidak menyetir
         sambil menatap aplikasi. Caranya foreground service bertipe location yang
         dinyalakan selagi aplikasi terbuka (dashboard_screen.dart,
         _mulaiPantauPosisi): Android tetap mengalirkan GPS ke layanan itu
         setelah layar terkunci, cukup dengan izin "saat aplikasi digunakan".

         Sengaja TANPA ACCESS_BACKGROUND_LOCATION. Izin itu tidak menambah apa pun
         di sini, sedangkan Google Play menuntut formulir, video, dan peninjauan
         khusus untuknya — dan sering menolak bila foreground service sudah cukup. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Wajib sejak Android 13 supaya notifikasi orderan bisa muncul. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Memindai QR setoran komisi. Kamera hanya dipakai di layar pindai;
         izinnya diminta sistem saat layar itu dibuka, bukan saat aplikasi mulai. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- allowBackup="false": token login tersimpan terenkripsi dengan kunci yang
         terikat ke HP ini (flutter_secure_storage). Kalau ikut dicadangkan dan
         dipulihkan ke HP baru, isinya tidak bisa dibuka lagi. Datanya ada di
         server, jadi di HP baru cukup login ulang. -->
    <application
        android:label="bohAntar"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher">
        <!-- Kunci Maps SDK, hanya untuk menggambar peta (tidak ditagih).
             Nilainya dari mapsApiKey di android/key.properties, lihat
             app/build.gradle.kts; dibatasi ke package + SHA-1 di Google Cloud.

             Kunci untuk Places (cari alamat) terpisah, ada di backend dan
             dikunci ke IP VPS, tidak pernah ikut ke dalam APK. Lihat
             backend/maps.go. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Sejak Android 11 aplikasi tidak bisa melihat aplikasi lain kecuali
             disebut di sini. Tanpa dua blok di bawah, canLaunchUrl() memulangkan
             false dan tombol "Telepon" maupun tautan kebijakan privasi diam saja
             tanpa pesan error. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
