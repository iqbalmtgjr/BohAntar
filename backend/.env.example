# CATATAN PENTING: server TIDAK membaca file ini.
# Backend hanya membaca environment variable asli dari shell. File ini murni
# daftar rujukan — salin nilainya menjadi baris "export" di script yang benar-benar
# menjalankan server:
#   - VPS  : script cron "Bohantar Backend Daemon" di panel (lihat cron-daemon.sh.example)
#   - lokal: set di terminal sebelum menjalankan `go run .`
#
# Wajib di produksi
APP_ENV=production
JWT_SECRET=            # minimal 32 karakter acak, mis. openssl rand -hex 32
GOOGLE_CLIENT_ID=      # Web Client ID dari Google Cloud Console
ADMIN_PASSWORD=        # hanya dipakai saat akun admin pertama kali dibuat

# Database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bohantar

# Pembayaran (kosongkan untuk mode mock; mock hanya aktif bila APP_ENV != production)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_SUB_ACCOUNT_ID=

PORT=8080
