#!/bin/bash
# Cron daemon bohAntar — dijalankan tiap 1 menit.
#
# Semua konfigurasi ada di run.sh; script ini sengaja tidak memuat variabel apa pun.
#
# Cron ini hanya penjaga: menyalakan backend kalau mati. Mengganti binary
# TIDAK lewat pkill lagi (jeda sampai satu menit) — pakai ganti-binary.sh,
# yang dijalankan otomatis oleh `rilis` di laptop, tanpa jeda layanan.

APP_DIR="/www/wwwroot/bohantar-backend"
CRON_LOG="$APP_DIR/cron-daemon.log"

exec 2>>"$CRON_LOG"
echo "[$(date '+%F %T')] cron jalan" >> "$CRON_LOG"

# Binary baru dari `rilis` lewat FTP (diunggah sebagai .part lalu diganti nama,
# jadi berkas ini tidak pernah setengah jadi): tukar tanpa jeda. Hasilnya ditulis
# ke ganti-binary.log, yang dibaca `rilis` di laptop lewat FTP.
if [ -f "$APP_DIR/bohantar-backend.baru" ] && [ -f "$APP_DIR/ganti-binary.sh" ]; then
    echo "[$(date '+%F %T')] binary baru ditemukan, menukar tanpa jeda" >> "$CRON_LOG"
    bash "$APP_DIR/ganti-binary.sh" > "$APP_DIR/ganti-binary.log" 2>&1
    tail -3 "$APP_DIR/ganti-binary.log" >> "$CRON_LOG"
    exit 0
fi

if pgrep -f "$APP_DIR/bohantar-backend" > /dev/null; then
    echo "[$(date '+%F %T')] sudah berjalan, tidak melakukan apa-apa" >> "$CRON_LOG"
    exit 0
fi

cd "$APP_DIR" || { echo "[$(date '+%F %T')] GAGAL cd ke $APP_DIR" >> "$CRON_LOG"; exit 1; }
chmod +x bohantar-backend

# setsid melepaskan proses dari sesi cron. Tanpa ini, banyak panel hosting
# membunuh seluruh process group begitu task cron selesai — backend ikut mati
# beberapa detik setelah dinyalakan. < /dev/null mencegahnya menunggu input.
setsid nohup bash run.sh > "$APP_DIR/backend.log" 2>&1 < /dev/null &

sleep 3
if pgrep -f "$APP_DIR/bohantar-backend" > /dev/null; then
    echo "[$(date '+%F %T')] BERHASIL dinyalakan" >> "$CRON_LOG"
else
    echo "[$(date '+%F %T')] GAGAL — isi backend.log:" >> "$CRON_LOG"
    tail -5 "$APP_DIR/backend.log" >> "$CRON_LOG"
fi
