# Salin jadi rilis.env (TIDAK masuk git — berisi password) lalu isi.
# Dipakai `rilis` (backend) dan `rilisweb` (dashboard) untuk mengunggah lewat
# FTP aaPanel. Kosongkan pasangan akun yang tidak dipakai; skrip lalu mencoba
# SSH, dan kalau itu pun tidak ada, berhenti setelah build dengan langkah manual.

FTP_HOST=103.150.194.141

# Akun FTP aaPanel yang foldernya /www/wwwroot/bohantar-backend.
# Binary diunggah sebagai bohantar-backend.baru; cron server (daemon.sh) yang
# menukarnya tanpa jeda dalam <= 1 menit.
FTP_BACKEND_USER=
FTP_BACKEND_PASS=

# Akun FTP aaPanel yang foldernya folder web dashboard BohAntar
# (yang berisi index.html dan assets/).
FTP_WEB_USER=
FTP_WEB_PASS=

# 1 = FTPS (password terenkripsi; aktifkan TLS di pengaturan FTP aaPanel dulu).
# 0 = FTP biasa, password lewat internet tanpa enkripsi — seperti akun Kasvo.
FTP_TLS=0
